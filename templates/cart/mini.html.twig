<div class="previewCart">
   {% if cart is empty %}
      <li>Votre panier est vide</li>
   {% else %}
   <ul class="previewCartList list-unstyled">

   {% set total = 0 %}

   {% for key, item in cart %}

      {# 👉 product peut être objet (DB) ou tableau (session) #}
      {% set product = item.product %}
      {% set category = product.productCategory ?? null %}

      {% set total = total + (product.price * item.quantity) %}

      <li class="previewCartItem clearfix">

         <a href="{% if category %}
                    {{ path('product_show', {categorySlug: category.slug, productSlug: product.slug}) }}
                 {% else %}# {% endif %}"
            class="previewCartItem-image">

            {% if item.image %}
               <img src="{{ item.image }}" width="110" height="157" alt="{{ item.color }}">
            {% elseif product.mainPhoto %}
               <img src="{{ asset('uploads/products/' ~ product.mainPhoto) }}" width="110" height="157" alt="{{ product.name }}">
            {% endif %}

         </a>

         <div class="previewCartItem-content">

            <a class="previewCartItem-name"
               href="{% if category %}
                        {{ path('product_show', {categorySlug: category.slug, productSlug: product.slug}) }}
                     {% else %}# {% endif %}">
               {{ product.name }} <br>
               <span>
                  Couleur : {{ item.color ?? 'N/A' }}
                  - Taille : {{ item.size ?? 'N/A' }}
               </span>
            </a>

            <div class="previewCartItem-change">

               <div class="previewCartItem-price">
                  <span style="color: #bb0000; font-size: 17px;">
                     {{ (product.price * item.quantity)|number_format(2, '.', ',') }} DZD
                  </span>
               </div>

               <div class="previewCartItem-subtotal">
                  Sous-total :
                  <strong>
                     {{ (product.price * item.quantity)|number_format(2, '.', ',') }} DZD
                  </strong>
               </div>

               <div class="previewCartItem-qt">
                  <input type="number"
                         class="form-input quantity qteitem"
                         value="{{ item.quantity }}"
                         data-update-id="{{ key }}">
               </div>
            </div>
         </div>

         <button type="button"
                 class="previewCartItem-remove"
                 data-cart-remove=""
                 data-cart-remove-id="{{ key }}"
                 title="Supprimer">
            ✖
         </button>

      </li>
   {% endfor %}
   </ul>

   <div class="previewCart-total">
      Total :
      <span id="mini-cart-total">
         {{ total|number_format(2, '.', ',') }}
      </span>
      DZD
   </div>

   {% endif %}
</div>