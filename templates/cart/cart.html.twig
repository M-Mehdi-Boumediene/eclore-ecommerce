<div class="halo-popup halo-edit-cart-popup customPopup-large" 
     id="halo-edit-cart-popup-global" 
     style="display:none; opacity:0; visibility:hidden;">
    <div class="halo-popup-wrapper">
        <div class="halo-popup-edit-header">
            <button type="button" class="halo-popup-close" data-close-edit-cart="">×</button>
            <h5 class="halo-popup-title"></h5>
