<script>
document.addEventListener('DOMContentLoaded', function() {
    const popup = document.getElementById('halo-edit-cart-popup-global');
    if (!popup) return console.error('Popup introuvable');

    const mainImage = popup.querySelector('.product-main-image');
    const title = popup.querySelector('.product-edit-title');
    const titleVariantColor = popup.querySelector('.label-value-1');
    const titleVariantSize = popup.querySelector('.label-value-2');
    const money = popup.querySelector('.product-edit-price .money');
    const quantityInput = popup.querySelector('.quantity__input');
    const colorFieldset = popup.querySelector('fieldset[data-option-index="0"]');
    const sizeFieldset = popup.querySelector('fieldset[data-option-index="1"]');
    const updateBtn = popup.querySelector('[data-update-cart-edit]');

    if (!updateBtn) return console.error('[data-update-cart-edit] introuvable');

    // --- Ouvrir popup ---
    document.addEventListener('click', function(e) {
        let btn = e.target;
        while (btn && !btn.classList.contains('cart-item-edit')) btn = btn.parentElement;
        if (!btn) return;
        e.preventDefault();

        const cartItem = btn.closest('.cart-item');
        if (!cartItem) return;

        // 🔹 Connexion ou visiteur
        const itemId = btn.dataset.editCartId || btn.dataset.key;
        if (!itemId) return console.error('data-key ou data-edit-cart-id manquant');
        popup.dataset.itemId = itemId;

        const productName = cartItem.querySelector('.cart-item-name a')?.innerText || '';
        const price = cartItem.querySelector('.cart-item-price')?.innerText || '';
        const quantity = cartItem.querySelector('.qteitem')?.value || 1;
        const variantText = cartItem.querySelector('.cart-item-variant')?.innerText || '';
        const [color, size] = variantText.split(' / ');
        const imgSrc = cartItem.querySelector('.cart-item-image img')?.src || '';

        let colorData = [], sizeData = [];
        try { colorData = JSON.parse(cartItem.dataset.colorImages || '[]'); } catch(e){ console.warn('colorImages invalide'); }
        try { sizeData = JSON.parse(cartItem.dataset.sizes || '[]'); } catch(e){ console.warn('sizes invalide'); }

        // Remplir popup
        title.textContent = productName;
        mainImage.src = imgSrc;
        mainImage.alt = productName;
        money.textContent = price;
        quantityInput.value = quantity;
        titleVariantColor.textContent = color || '';
        titleVariantSize.textContent = size || '';

        // Couleurs
        colorFieldset.innerHTML = `<legend class="form__label">Color: <span data-header-option="">${color || ''}</span></legend>`;
        colorData.forEach((c,i)=>{
            colorFieldset.innerHTML += `
                <input class="product-form__radio" type="radio" id="color-${i}" name="edit-cart-Color" value="${c.name}" ${c.name===color?'checked':''} data-image="${c.img}">
                <label class="product-form__label available" for="color-${i}">
                    <span class="pattern" style="background-color:${c.hex}; background: url('${c.img}'); background-size: cover;"></span>
                </label>`;
        });

        // Tailles
        sizeFieldset.innerHTML = `<legend class="form__label">Size: <span data-header-option="">${size || ''}</span></legend>`;
        sizeData.forEach((s,i)=>{
            sizeFieldset.innerHTML += `
                <input class="product-form__radio" type="radio" id="size-${i}" name="edit-cart-Size" value="${s}" ${s===size?'checked':''}>
                <label class="product-form__label available" for="size-${i}">
                    <span class="text">${s}</span>
                </label>`;
        });

        // Changement dynamique
        colorFieldset.querySelectorAll('input[name="edit-cart-Color"]').forEach(input=>{
            input.addEventListener('change', function() {
                mainImage.src = this.dataset.image;
                titleVariantColor.textContent = this.value;
                colorFieldset.querySelector('span[data-header-option]').textContent = this.value;
            });
        });
        sizeFieldset.querySelectorAll('input[name="edit-cart-Size"]').forEach(input=>{
            input.addEventListener('change', function() {
                titleVariantSize.textContent = this.value;
                sizeFieldset.querySelector('span[data-header-option]').textContent = this.value;
            });
        });

        // Afficher popup
        popup.style.display = 'flex';
        setTimeout(()=>{popup.style.opacity='1'; popup.style.visibility='visible';},10);
    });

    // --- Fermer popup ---
    document.querySelectorAll('[data-close-edit-cart]').forEach(btn=>{
        btn.addEventListener('click', ()=>{ 
            popup.style.opacity='0';
            popup.style.visibility='hidden';
            setTimeout(()=>{popup.style.display='none';},300);
        });
    });

    // --- Update panier via AJAX ---
    updateBtn.addEventListener('click', function(e){
        e.preventDefault(); e.stopPropagation();
        const itemId = popup.dataset.itemId;
        if(!itemId) return alert('Item introuvable');

        const quantity = parseInt(quantityInput.value) || 1;
        const color = popup.querySelector('input[name="edit-cart-Color"]:checked')?.value || null;
        const size = popup.querySelector('input[name="edit-cart-Size"]:checked')?.value || null;

        fetch(`/cart/update-ajax/${itemId}`, {
            method:'POST',
            headers:{ 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest' },
            body: JSON.stringify({quantity,color,size})
        })
        .then(async res=>{
            const text = await res.text();
            let data;
            try { data = JSON.parse(text); } catch(e){ alert('Réponse serveur invalide'); return; }

            if(data.success){
                const miniCart = document.querySelector('#mini-cart-container');
                if(miniCart) miniCart.innerHTML = data.html;

                // Ligne panier
                const cartItemEl = document.querySelector(`.cart-item[data-key="${itemId}"], .cart-item[data-edit-cart-id="${itemId.split('-')[0]}"]`);
                if(cartItemEl){
                    cartItemEl.querySelector('.qteitem').value = quantity;
                    const variantSpan = cartItemEl.querySelector('.cart-item-variant');
                    if(variantSpan) variantSpan.textContent=[color,size].filter(v=>v).join(' / ');
                    const lineTotalEl = cartItemEl.querySelector('.cart-item-total');
                    if(lineTotalEl) lineTotalEl.textContent=parseFloat(data.lineTotal).toFixed(2)+' DA';
                }

                const totalEl = document.querySelector('.cart-total-grandtotal .money');
                if(totalEl) totalEl.textContent=parseFloat(data.total).toFixed(2)+' DA';

                popup.style.opacity='0';
                popup.style.visibility='hidden';
                setTimeout(()=>{popup.style.display='none';},300);
            } else {
                alert(data.message || 'Impossible de mettre à jour le panier');
            }
        })
        .catch(err=>{ console.error('FETCH ERROR:', err); alert('Erreur mise à jour panier'); });
    });
});


// --- Mettre à jour les sous-totaux et total dynamiquement ---
function updateCartTotals() {
    let subtotal = 0;
    document.querySelectorAll('.cart-item').forEach(item => {
        const priceEl = item.querySelector('.cart-item-price');
        const quantityEl = item.querySelector('.qteitem');
        const lineTotalEl = item.querySelector('.cart-item-total');

        const price = parseFloat(priceEl.textContent.replace(/[^0-9.]/g, '')) || 0;
        const quantity = parseInt(quantityEl.value) || 1;
        const lineTotal = price * quantity;

        if(lineTotalEl) {
            lineTotalEl.textContent = lineTotal.toFixed(2) + ' DA';
            lineTotalEl.dataset.lineTotal = lineTotal; // mettre à jour l'attribut
        }

        subtotal += lineTotal;
    });

    // Mettre à jour sous-total
    const subtotalEl = document.querySelector('.cart-total-subtotal .money');
    if(subtotalEl) subtotalEl.textContent = subtotal.toFixed(2) + ' DA';

    // Mettre à jour total
    const totalEl = document.querySelector('.cart-total-grandtotal .money');
    if(totalEl) totalEl.textContent = subtotal.toFixed(2) + ' DA';
}

// --- Ajouter l'événement change sur les quantités ---
document.querySelectorAll('.qteitem').forEach(input => {
    input.addEventListener('change', function() {
        if(this.value < 1) this.value = 1;
        updateCartTotals();
    });
});

// --- Initialiser au chargement de la page ---
document.addEventListener('DOMContentLoaded', updateCartTotals);

// --- Ajouter l'événement change sur l'input du popup ---
const popupQuantityInput = document.querySelector('.quantity__input');
if(popupQuantityInput) {
    popupQuantityInput.addEventListener('change', function() {
        if(this.value < 1) this.value = 1;

        // Mettre à jour la quantité dans la ligne du panier correspondante
        const itemId = document.getElementById('halo-edit-cart-popup-global')?.dataset.itemId;
        if(itemId){
            const cartItemEl = document.querySelector(`.cart-item[data-key="${itemId}"], .cart-item[data-edit-cart-id="${itemId.split('-')[0]}"]`);
            if(cartItemEl){
                const qteItem = cartItemEl.querySelector('.qteitem');
                if(qteItem) qteItem.value = parseInt(this.value);
            }
        }

        // Recalculer les totaux
        updateCartTotals();
    });
}
document.addEventListener('DOMContentLoaded', function() {
    const checkbox = document.querySelector('#cart_conditions');
    const checkoutBtn = document.querySelector('#cart-checkout');

    if (!checkbox || !checkoutBtn) return;

    // Écouter le changement du checkbox
    checkbox.addEventListener('change', function() {
        checkoutBtn.disabled = !this.checked; // active si coché, désactive si décoché
    });

    // Initialisation au chargement (au cas où le checkbox serait déjà coché)
    checkoutBtn.disabled = !checkbox.checked;
});


document.addEventListener('DOMContentLoaded', function() {

    function updateCartTotals() {
        let subtotal = 0;
        document.querySelectorAll('.cart-item').forEach(item => {
            const priceText = item.querySelector('.cart-item-price')?.textContent || '0';
            const quantity = parseInt(item.querySelector('.qteitem')?.value || 1);
            const price = parseFloat(priceText.replace(/[^0-9.-]+/g,"")) || 0;
            subtotal += price * quantity;
        });

        const subtotalEl = document.querySelector('.cart-total-subtotal .money');
        const totalEl = document.querySelector('.cart-total-grandtotal .money');
        if(subtotalEl) subtotalEl.textContent = subtotal.toFixed(2) + ' DA';
        if(totalEl) totalEl.textContent = subtotal.toFixed(2) + ' DA';
    }

    function attachRemoveListeners() {
        document.querySelectorAll('.cart-remove').forEach(btn => {
            btn.removeEventListener('click', btn._removeHandler); // nettoyer ancien handler
            btn._removeHandler = function(e) {
                e.preventDefault();
                const itemId = this.dataset.line; // correspond à CartItem->id
                if (!itemId) return console.error('data-line manquant pour suppression');

                fetch(`/cart/remove-ajax/${itemId}`, {
                    method:'POST',
                    headers:{ 'Content-Type':'application/json', 'X-Requested-With':'XMLHttpRequest' }
                })
                .then(async res => {
                    const text = await res.text();
                    let data;
                    try { data = JSON.parse(text); } 
                    catch(e){ console.error('Réponse serveur invalide'); return; }

                    if(data.success){
                        // Supprimer du DOM
                        const cartItemEl = document.querySelector(`.cart-item[data-line="${itemId}"]`);
                        if(cartItemEl) cartItemEl.remove();

                        // Mettre à jour mini-cart
                        const miniCart = document.querySelector('#mini-cart-container');
                        if(miniCart && data.html) miniCart.innerHTML = data.html;

                        // Recalculer totaux
                        updateCartTotals();
                    } else {
                        alert(data.message || 'Impossible de supprimer le produit');
                    }
                })
                .catch(err => { console.error('Erreur AJAX suppression:', err); alert('Erreur lors de la suppression'); });
            };
            btn.addEventListener('click', btn._removeHandler);
        });
    }

    // --- Initialisation ---
    updateCartTotals();
    attachRemoveListeners();
});
</script>

