{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<style>
.tab-buttons {
    display: flex;
    gap: 10px; /* espace entre les boutons */
    margin-bottom: 20px;
}

.tab-btn {
    flex: 1; /* même largeur pour tous */
    padding: 10px 15px;
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    border-bottom: none; /* pour donner l’effet onglet */
    border-radius: 5px 5px 0 0;
    cursor: pointer;
    font-weight: 500;
    color: #333;
    transition: all 0.2s ease;
    text-align: center;
}

.tab-btn:hover {
    background-color: #eaeaea;
}

.tab-btn.active {
    background-color: #1f1f1f;
    border-bottom: 1px solid #fff; /* pour l’effet “sélectionné” */
    color: #fff; /* couleur principale du thème */
    font-weight: 600;
}

button, input[type="submit"] {
  pointer-events: auto !important;
}
</style>
<main id="MainContent" class="wrapper-body content-for-layout focus-none" role="main" tabindex="-1">
  
       
                  
                   
                        <h2 class="halo-page-title page-subheader text-left">
                           Se connecter à votre compte
                        </h2>
                        <div class="halo-page-wrapper">
                           <div class="login-text">
                              Veuillez saisir votre adresse e-mail et votre mot de passe ci-dessous pour accéder à votre compte.
                           </div>
                                        <form method="post" action="{{ path('app_login') }}" id="customer_login" class="customer-login-form">
                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            {% if app.user %}
                                <div class="mb-3">
                                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ logout_path() }}">Logout</a>
                                </div>
                            {% endif %}

                    <div class="form-field">
                        <label class="form-label" for="username">
                            Adresse email <em>*</em>
                        </label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-input form-input-placeholder" required autofocus>
                    </div>

                    <div class="form-field">
                        <label class="form-label" for="password">
                            Password <em>*</em>
                        </label>
                        <input type="password" name="_password" id="password" class="form-input form-input-placeholder"  required>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="button button-2">Se connecter</button>
                        <a href="#recover" class="link link-underline forget-password">
                            <span class="text">Mot de passe oublié ?</span>
                        </a>
                    </div>

                    <input type="hidden" name="login_with_shop[analytics_trace_id]" value="ecc60cd1-e8ba-41aa-8124-2555447dc6eb">
                </form>


{% endblock %}
