{% extends 'base.html.twig' %}

{% block title %}Hello CheckoutController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<h2>Votre panier</h2>

{% set total = 0 %}

<table>
    <thead>
        <tr>
            <th>Produit</th>
            <th>Quantité</th>
            <th>Prix</th>
            <th>Sous-total</th>
        </tr>
    </thead>
    <tbody>
        {% for item in cart %}
            {% set price = item.product.price %}
            {% set subtotal = price * item.quantity %}
            {% set total = total + subtotal %}
            <tr>
                <td>{{ item.product.name }}</td>
                <td>{{ item.quantity }}</td>
                <td>{{ price }} €</td>
                <td>{{ subtotal }} €</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<h3>Total : {{ total }} €</h3>

<hr>

<h2>Informations de livraison</h2>

{{ form_start(form) }}

    {{ form_row(form.address) }}
    {{ form_row(form.fullName) }}
    {{ form_row(form.phone) }}
    {{ form_row(form.email) }}

    <button type="submit" class="btn btn-primary">
        Commander
    </button>
{{ form_end(form) }}
{% endblock %}
