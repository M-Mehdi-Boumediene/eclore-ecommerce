<script>
document.addEventListener('DOMContentLoaded', function() {

    function getContainer(el) {
        return el.closest('.variants-popup') || el.closest('.product');
    }

    function updateColorLabel(container) {
        const input = container.querySelector('.selector-wrapper-1 input.single-option:checked');
        const label = container.querySelector('.selector-wrapper-1 .label-value-1');
        if (input && label) label.textContent = input.value;
    }

    function updateSizeLabel(container) {
        const input = container.querySelector('.selector-wrapper-2 input.single-option:checked');
        const label = container.querySelector('.selector-wrapper-2 .label-value-2');
        if (input && label) label.textContent = input.value;
    }

    // 🔁 changement couleur / taille
    document.body.addEventListener('change', function(e) {
        const input = e.target.closest('.single-option');
        if (!input) return;

        const container = getContainer(input);
        if (!container) return;

        updateColorLabel(container);
        updateSizeLabel(container);
    });

    // 🛒 ADD TO CART
    document.body.addEventListener('click', function(e) {
        const button = e.target.closest('.add-to-cart-btn');
        if (!button) return;

        e.preventDefault();
        e.stopImmediatePropagation();

        const container = getContainer(button);
        if (!container) return;

        const productBox = container.closest('[data-product-id]');
        const productId = productBox ? productBox.dataset.productId : container.dataset.productId;

        const colorInput = container.querySelector('.selector-wrapper-1 input.single-option:checked');
        const sizeInput = container.querySelector('.selector-wrapper-2 input.single-option:checked');
        const qtyInput = container.querySelector('input[name="quantity"]');

        const payload = {
            color: colorInput ? colorInput.value : null,
            image: colorInput ? colorInput.dataset.image : null,
            size: sizeInput ? sizeInput.value : null,
            quantity: qtyInput ? parseInt(qtyInput.value) || 1 : 1
        };

        fetch(`/cart/add-ajax/${productId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (!data.success) return;

            refreshMiniCart(data.html);

            const cartBtn = document.querySelector('[data-cart-sidebar]');
            if (cartBtn) cartBtn.click();

            const cancelBtn = container.querySelector('[data-cancel-quickshop-popup]');
            if (cancelBtn) cancelBtn.click();

            updateColorLabel(container);
            updateSizeLabel(container);
        });
    });

});
</script>
<script>
document.addEventListener('change', function (e) {
    const input = e.target.closest('.qteitem');
    if (!input) return;

    const key = input.dataset.updateId;
    const quantity = parseInt(input.value) || 1;

    fetch('/cart/update-ajax/' + key, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ quantity })
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) return;

        refreshMiniCart(data.html);
    });
});


</script>
<script>
document.addEventListener('click', function(e) {

    const btn = e.target.closest('[data-cart-remove-id]');
    if (!btn) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const key = btn.dataset.cartRemoveId;
    if (!key) {
        console.error('clé panier manquante');
        return;
    }

    fetch('/cart/remove-ajax/' + key, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) return;

        // ✅ utiliser la fonction globale
        refreshMiniCart(data.html);

    });
});

</script>
<script>
function refreshMiniCart(html) {

    let container = document.querySelector('#previewCartContainer');

    if (!container) {
        container = document.createElement('div');
        container.id = 'previewCartContainer';
        document.body.appendChild(container);
    }

    container.innerHTML = html;

    const totalEl = container.querySelector('#mini-cart-total');

    const totalBox = document.querySelector('[data-cart-total-value] .money');
    const subtotalBox = document.querySelector('[data-cart-subtotal] .money');
    const discountBox = document.querySelector('[data-saved-discount-value] .money');

    if (totalEl) {
        const total = totalEl.textContent;
        if(totalBox) totalBox.textContent = total + ' DZD';
        if(subtotalBox) subtotalBox.textContent = total + ' DZD';
    } else {
        // Panier vide → tout à zéro
        if(totalBox) totalBox.textContent = '0.00 DZD';
        if(subtotalBox) subtotalBox.textContent = '0.00 DZD';
        if(discountBox) discountBox.textContent = '0.00 DZD';
    }
}
</script>

<script>
document.body.addEventListener('click', function(e) {

    // remonte jusqu'au label (même si on clique sur le span)
    const label = e.target.closest('.swatch-label');
    if (!label) return;

    console.log("Swatch cliqué :", label.dataset.value);

    const productId = label.dataset.productId;
    if (productId) {
        document.querySelectorAll('.swatch-label[data-product-id="' + productId + '"]')
            .forEach(l => l.classList.remove('is-active'));
    }

    label.classList.add('is-active');

    // sync popup
    const popup = document.querySelector('.variants-popup[data-product-id="' + productId + '"]');
    if (popup) {
        const color = label.dataset.value;
        const radio = popup.querySelector('input.single-option[value="' + color + '"]');

        if (radio) {
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
        }
    }
});
</script>
