<script>
document.addEventListener('click', function (e) {
  const swatch = e.target.closest('.swatch-label');
  const product = swatch ? swatch.closest('.product') : e.target.closest('.product');
  if (!product) return;

  const media = product.querySelector('.card-media');
  if (!media) return;

  let mainImg = media.querySelector('img');
  let mainVideo = media.querySelector('video');

  // 📌 Si on clique sur un swatch, on met à jour image/vidéo
  if (swatch) {
    e.preventDefault();
    e.stopImmediatePropagation();

    const variantId = swatch.dataset.variantId;
    const variantImg = swatch.dataset.variantImg;
    const variantVideo = swatch.dataset.variantVideo;

    if (variantVideo) {
      if (!mainVideo) {
        mainVideo = document.createElement('video');
        mainVideo.muted = true;
        mainVideo.loop = true;
        mainVideo.autoplay = false;
        mainVideo.playsInline = true;
        mainVideo.style.width = '100%';
        mainVideo.style.position = 'absolute';
        mainVideo.style.top = '0';
        mainVideo.style.left = '0';
        mainVideo.style.display = 'none';
        media.appendChild(mainVideo);
      }
      mainVideo.src = variantVideo;
    }

    if (variantImg && mainImg) {
      mainImg.src = variantImg;
      mainImg.srcset = variantImg;
      mainImg.style.display = 'block';
    }

    // Gestion des liens et titre
    product.querySelectorAll('a[href*="?variant="]').forEach(link => {
      const baseUrl = link.href.split('?')[0];
      link.href = `${baseUrl}?variant=${variantId}`;
    });
    const titleVariant = product.querySelector('[data-change-title]');
    if (titleVariant) titleVariant.textContent = ' - ' + swatch.dataset.value;

    // État actif swatch
    const swatchContainer = swatch.closest('.swatch');
    if (swatchContainer) {
      swatchContainer.querySelectorAll('.swatch-label').forEach(l => l.classList.remove('is-active'));
      swatch.classList.add('is-active');
    }
  }

  const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

  if (mainVideo) {
    if (isMobile) {
      // Mobile : lecture directe dès le premier affichage
      mainVideo.style.display = 'block';
      mainVideo.play().catch(() => console.warn("Lecture vidéo bloquée sur mobile"));
    } else {
      // Desktop : hover
      media.addEventListener('mouseenter', () => {
        mainVideo.style.display = 'block';
        mainVideo.play();
      });
      media.addEventListener('mouseleave', () => {
        mainVideo.pause();
        mainVideo.style.display = 'none';
      });
    }
  }
});
</script>










