    const colorRadios = document.querySelectorAll('.product-form__input[data-option-index="0"] .product-form__radio');
    const colorSpan = document.querySelector('.product-form__input[data-option-index="0"] [data-header-option]');
    const slickSlider = $('.productView-nav'); // ton slider Slick

    colorRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.checked) {
                const imageId = this.getAttribute('data-image-id');

                // Mettre à jour le nom de la couleur
                if(colorSpan) colorSpan.textContent = this.value;

                // Changer l'image principale via Slick
                let targetIndex = 0;
                slickSlider.find('.productView-image').each(function(index) {
                    if ($(this).find('[data-media-id="' + imageId + '"]').length) {
                        targetIndex = index;
                    }
                });

                slickSlider.slick('slickGoTo', targetIndex);
            }
        });
    });

    // --------- SIZE ---------
    const sizeRadios = document.querySelectorAll('.product-form__input[data-option-index="1"] .product-form__radio');
    const sizeSpan = document.querySelector('.product-form__input[data-option-index="1"] [data-header-option]');

    sizeRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.checked && sizeSpan) {
                sizeSpan.textContent = this.value;
            }
        });
    });

});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    // Slider Slick
    const slickSlider = $('.productView-nav');

    // ---- Changement de couleur ----
    document.querySelectorAll('.product-form__input[data-option-index="0"] .product-form__radio')
        .forEach(radio => {
            radio.addEventListener('change', function () {
                if (!this.checked) return;

                const colorSpan = this.closest('.product-form__input').querySelector('[data-header-option]');
                if (colorSpan) colorSpan.textContent = this.value;

                // Changer l'image dans Slick
                const imageId = this.dataset.imageId;
                let targetIndex = 0;
                slickSlider.find('.productView-image').each(function (index) {
                    if ($(this).find('[data-media-id="' + imageId + '"]').length) {
                        targetIndex = index;
                    }
                });
                slickSlider.slick('slickGoTo', targetIndex);
            });
        });

    // ---- Changement de taille ----
    document.querySelectorAll('.product-form__input[data-option-index="1"] .product-form__radio')
        .forEach(radio => {
            radio.addEventListener('change', function () {
                const sizeSpan = this.closest('.product-form__input').querySelector('[data-header-option]');
                if (sizeSpan && this.checked) sizeSpan.textContent = this.value;
            });
        });
});

// ---- Ajout au panier ----
document.addEventListener('click', function (e) {
    const button = e.target.closest('[data-btn-addtocart]');
    if (!button) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const productId = button.dataset.productId;
    if (!productId) {
        console.error("Product ID manquant !");
        return;
    }

    const variantContainer = document.getElementById('variant-' + productId);
    if (!variantContainer) {
        console.error("Variant container introuvable !");
        return;
    }

    // Récupérer couleur / taille
    const selectedColorInput = variantContainer.querySelector('.product-form__input[data-option-index="0"] input:checked');
    const selectedSizeInput  = variantContainer.querySelector('.product-form__input[data-option-index="1"] input:checked');

    if (!selectedColorInput || !selectedSizeInput) {
        alert("Veuillez sélectionner une couleur et une taille");
        return;
    }

    const selectedColor = selectedColorInput.value;
    const selectedImage = selectedColorInput.dataset.image; // <-- URL correcte pour mini-cart
    const selectedSize  = selectedSizeInput.value;

    const qtyInput = variantContainer.querySelector('input[name="quantity"]');
    const quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

    // Ajax add-to-cart
    fetch(`/cart/add-ajax/${productId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({
            color: selectedColor,
            image: selectedImage,
            size: selectedSize,
            quantity: quantity
        })
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) return;

        let container = document.querySelector('#previewCartContainer');
        if (!container) {
            container = document.createElement('div');
            container.id = 'previewCartContainer';
            document.body.appendChild(container);
        }
        container.innerHTML = data.html;

        const cartSidebarBtn = document.querySelector('[data-cart-sidebar]');
        if (cartSidebarBtn) cartSidebarBtn.click();
    })
    .catch(err => console.error("Erreur add-to-cart :", err));
});
</script>
<script>
document.addEventListener('change', function (e) {
    const input = e.target.closest('.qteitem');
    if (!input) return;

    const key = input.dataset.updateId;
    const quantity = parseInt(input.value) || 1;

    fetch('/cart/update-ajax/' + key, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: JSON.stringify({ quantity })
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) return;

        refreshMiniCart(data.html, data.total);
    });
});

function refreshMiniCart(html, total) {
    let container = document.querySelector('#previewCartContainer');

    if (!container) {
        container = document.createElement('div');
        container.id = 'previewCartContainer';
        document.body.appendChild(container);
    }

    container.innerHTML = html;

    // update total
    const totalEl = container.querySelector('#mini-cart-total');
    if (totalEl && total !== undefined) {
        totalEl.textContent = total.toFixed(2);
    }
}
</script>
<script>
function refreshMiniCart(html) {
    let container = document.querySelector('#previewCartContainer');

    if (!container) {
        container = document.createElement('div');
        container.id = 'previewCartContainer';
        document.body.appendChild(container);
    }

    container.innerHTML = html;

    // update total sidebar
    const totalEl = container.querySelector('#mini-cart-total');
    if (totalEl) {
        document.querySelector('[data-cart-total-value] .money').textContent =
            totalEl.textContent + ' DZD';

        document.querySelector('[data-cart-subtotal] .money').textContent =
            totalEl.textContent + ' DZD';
    }
}
</script>
<script>
document.addEventListener('click', function(e) {

    const btn = e.target.closest('[data-cart-remove-id]');
    if (!btn) return;

    e.preventDefault();
    e.stopImmediatePropagation();

    const key = btn.dataset.cartRemoveId;
    if (!key) {
        console.error('clé panier manquante');
        return;
    }

    fetch('/cart/remove-ajax/' + key, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(res => res.json())
    .then(data => {
        if (!data.success) return;

        let container = document.querySelector('#previewCartContainer');

        if (!container) {
            container = document.createElement('div');
            container.id = 'previewCartContainer';
            document.body.appendChild(container);
        }

        container.innerHTML = data.html;
    });
});
</script>
