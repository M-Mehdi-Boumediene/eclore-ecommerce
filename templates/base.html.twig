document.addEventListener("DOMContentLoaded", function () {

    const desktopNav = document.querySelector(".section-header-navigation");
    const mobileNav = document.querySelector(".sticky-header-mobile");

    let lastScroll = window.pageYOffset;

        const mainLogo = document.querySelector(".header-logo.header-item.header-item--side.d-flex.flex-align-center.d-flex.fs-0.fg-0.pt-2.pb-5.hide-main-menu"); // logo à cacher
         const mainIcons = document.querySelector("header-icons header-item header-item--side d-flex flex-align-stretch flex-wrap fs-0 hide-main-menu header-icons-border header-icons-sticky-border");


  

    function updateHeader() {

        const currentScroll = window.pageYOffset;

        /* ================= DESKTOP ================= */
        if (desktopNav) {

            if (currentScroll === 0) {
                // 🔹 Tout en haut → position naturelle
                desktopNav.style.position = "fixed";
                desktopNav.style.transform = "translateY(0px)";
                desktopNav.style.top = "137px";
               
                    if (mainLogo) {
        mainLogo.style.display = "none";
    }
              if (mainIcons) {
        mainIcons.style.display = "none";
    }
            } 
            else if (currentScroll > lastScroll && currentScroll > 50) {
                // 🔹 Scroll vers le bas → cacher
                desktopNav.style.position = "fixed";
                desktopNav.style.top = "0";
                desktopNav.style.transform = "translateY(-100%)";
            } 
            else {
                // 🔹 Scroll vers le haut → afficher fixé en haut
                desktopNav.style.position = "fixed";
                desktopNav.style.top = "0";
                desktopNav.style.transform = "translateY(0)";

                                    if (mainLogo) {
        mainLogo.style.display = "block";
    }
              if (mainIcons) {
        mainIcons.style.display = "block";
    }
            }
        }

        /* ================= MOBILE ================= */
        if (mobileNav) {

            if (currentScroll > lastScroll && currentScroll > 50) {
                mobileNav.style.transform = "translateY(-100%)";
                mobileNav.style.position = "fixed";
                mobileNav.style.top = "0";
            } else {
                mobileNav.style.transform = "translateY(0)";
               mobileNav.style.top = "0";
               mobileNav.style.position = "fixed";
            }
        }

        lastScroll = currentScroll;
    }

    updateHeader();
    window.addEventListener("scroll", updateHeader);

    

});



